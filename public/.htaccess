# ==============================================================================
# GastoSmart - Configuración de Seguridad y Servidor Apache (Hostinger)
# Diseñado para superar con calificación A+ escáneres de seguridad (VulnScope / OWASP)
# ==============================================================================

# 1. Configuración de Directorio por Defecto
DirectoryIndex index.php index.html

# 2. Protección de Archivos Expuestos: Desactivar Listado de Directorios
Options -Indexes

# 3. Forzar Redirección HTTPS / TLS Seguro
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 4. Cabeceras de Seguridad Avanzada (OWASP / VulnScope Compliance)
<IfModule mod_headers.c>
    # Prevención contra Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevención contra interpretación MIME engañosa (MIME Sniffing)
    Header always set X-Content-Type-Options "nosniff"

    # HSTS (HTTP Strict Transport Security): 1 año forzando HTTPS y subdominios
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Control de Referrer seguro para llamadas API
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restricción de permisos del navegador (Cámara, micrófono, geolocalización)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Protección XSS heredada
    Header always set X-XSS-Protection "1; mode=block"

    # Content Security Policy (CSP) robusta y compatible con Tailwind y APIs
    Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://gastosmart.vercel.app https://*.supabase.co https://open.er-api.com https://v6.exchangerate-api.com https://generativelanguage.googleapis.com https://api.brevo.com; img-src 'self' data: https: blob:; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com; frame-ancestors 'self';"

    # Ocultar huellas del servidor
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# 5. Bloqueo Estricto de Archivos Expuestos (.env, .git, backups, logs, bases de datos)
<FilesMatch "^\.(env|git|gitignore|htaccess)|(\.sql|\.log|\.bak|\.backup|\.md|\.json|\.lock|\.ini|\.sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Bloqueo de Sondas de Ataque CMS (WordPress XML-RPC, wp-login, etc.)
<FilesMatch "(xmlrpc\.php|wp-login\.php|wp-admin|wp-config\.php)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 7. Tipos MIME Correctos y Codificación UTF-8
AddDefaultCharset UTF-8
AddType text/html .html
AddType text/css .css
AddType application/javascript .js
AddType image/png .png
AddType image/svg+xml .svg
AddType application/json .json
